// Author: @AliSawari 16.10.2023 (updated with flat-range + BB(8) trend filters)

//@version=5
indicator("BB-Pullback new ", shorttitle = "BB-PullBack New", overlay=true)

// ======================= Inputs =======================
stDev       = input.float(2.0, "StDev")
offset      = input.int(5, "Offset for BB PB Approximation")
BB_SHORT    = input.int(8, "Short BB")
BB_LONG1    = input.int(100, "Long BB1")
BB_LONG2    = input.int(200, "Long BB2")
BB_LONG3    = input.int(400, "Long BB3")
RSI_LEN     = input.int(14, "RSI")
RSI_UP      = input.int(69, "RSI Upper Level")
RSI_DOWN    = input.int(31, "RSI Lower Level")

SL_To_Body_Ratio   = input.float(0.25, "SL_To_Body_Ratio", minval=0)
calcIn3Candles     = input.bool(false, "calcIn3Candles")
disableBB100       = input.bool(true, "disableBB100")

// ---- New: Flatness parameters ----
flat_W     = input.int(30, "Flatness Window W", minval=8)
epsSlope   = input.float(0.08, "Flat: Max normalized slope", step=0.01)
epsCurv    = input.float(0.12, "Flat: Max curvature", step=0.01)
epsCv      = input.float(0.25, "Flat: Max BW Coef.Var.", step=0.01)
epsBwRel   = input.float(0.02, "Flat: Max Rel. Bandwidth", step=0.001)
useADX     = input.bool(false, "Flat: Require ADX filter?")
adxLen     = input.int(14, "ADX Length", minval=5)
adxMax     = input.float(15.0, "ADX must be <", step=0.5)

// ======================= Core series =======================
[basisS, ShortBB_upper, ShortBB_lower] = ta.bb(close, BB_SHORT, stDev)
[basis1, LongBB1_upper, LongBB1_lower] = ta.bb(close, BB_LONG1, stDev)
[basis2, LongBB2_upper, LongBB2_lower] = ta.bb(close, BB_LONG2, stDev)
[basis3, LongBB3_upper, LongBB3_lower] = ta.bb(close, BB_LONG3, stDev)

RSI = ta.rsi(close, RSI_LEN)

// ======================= Time-scaling legacy (kept as-is) =======================
pointA           = input.int(5, "Flatness Legacy Point A")
pointB           = input.int(1, "Flatness Legacy Point B")
FiveM_Mult       = input.int(3)
FifteenM_Mult    = input.int(5)
OneH_Mult        = input.int(10)
FourH_Mult       = input.int(20)

T = timeframe.period
timeMulti = T == "D" ? 100 :
     T == "240" ? FourH_Mult :
     T == "60"  ? OneH_Mult :
     T == "15"  ? FifteenM_Mult :
     T == "5"   ? FiveM_Mult : 1

level1 = (syminfo.mintick * timeMulti)

// ======================= Helpers =======================
isRSIValid(candleIndex, hitUp) =>
    rUp   = math.ceil(RSI[candleIndex]) >= RSI_UP
    rDown = math.floor(RSI[candleIndex]) <= RSI_DOWN
    hitUp ? rUp : rDown

isHittingBB(candleIndex, BB_LEN, hitUp) =>
    [_, u, l] = ta.bb(close, BB_LEN,  stDev)
    [_, u2,l2] = ta.bb(close, BB_LEN - math.min(offset, BB_LEN-1), stDev)
    hitUp ? ((high[candleIndex] >= u and low[candleIndex] <= u) or (high[candleIndex] >= u2 and low[candleIndex] <= u2))
          : ((high[candleIndex] >= l and low[candleIndex] <= l) or (high[candleIndex] >= l2 and low[candleIndex] <= l2))

// ---- Old "isBBInRange" kept but bypassed by new flatness logic when useFlatRange=true ----
isBBInRangeCalculation = input.bool(false, "LEGACY: isBBInRangeCalculation (visual test only)")
isBBInRange_legacy(BB_LEN) =>
    [_, u, l] = ta.bb(close, BB_LEN, stDev)
    diff_lower = l[pointB] - l[pointA]
    diff_upper = u[pointB] - u[pointA]
    slopeLower = (diff_lower) / (pointA - pointB)
    slopeUpper = (diff_upper) / (pointA - pointB)
    tanjantLower = math.abs(math.tan(slopeLower))
    tanjantUpper = math.abs(math.tan(slopeUpper))
    isInRange = tanjantLower == 0 or tanjantUpper == 0
    isBBInRangeCalculation ? isInRange : true

// ======================= New: Flat-Range detection =======================
// slope at bar offset "off" over len L using linreg increment method
_slope(sr, L, off) =>
    ta.linreg(sr, L, off) - ta.linreg(sr, L, off + 1)



adxCustom(len) =>
    upMove   = ta.change(high)
    downMove = -ta.change(low)
    plusDM   = (upMove > downMove and upMove > 0) ? upMove : 0.0
    minusDM  = (downMove > upMove and downMove > 0) ? downMove : 0.0

    // True Range (manual to avoid version quirks)
    tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))

    // Wilder’s RMA smoothing
    trRma      = ta.rma(tr,       len)
    plusDM_RMA = ta.rma(plusDM,   len)
    minusDM_RMA= ta.rma(minusDM,  len)

    plusDI  = 100.0 * (plusDM_RMA  / trRma)
    minusDI = 100.0 * (minusDM_RMA / trRma)
    dx      = 100.0 * math.abs(plusDI - minusDI) / math.max(plusDI + minusDI, 1e-9)

    ta.rma(dx, len)  // ADX

// main flatness check for BB length n 

isFlatBB(n) =>
    // derive basis and bandwidth for BB(n)
    b  = ta.sma(close, n)
    sd = ta.stdev(close, n)
    u  = b + stDev * sd
    l  = b - stDev * sd
    bw = u - l

    // not enough history?
    valid = not na(b) and not na(bw) and bar_index > (n + flat_W + 5)
    if valid
        atrW   = ta.atr(flat_W)
        atrWnz = atrW == 0.0 ? 1e-9 : atrW

        // A) near-zero slope (normalized by ATR)
        s_mid  = _slope(b, flat_W, 0)
        s_norm = math.abs(s_mid) / atrWnz
        A = s_norm < epsSlope

        // B) low curvature
        half     = math.max(4, math.floor(flat_W / 2))
        s_late   = _slope(b, half, 0)
        s_early  = _slope(b, half, half)
        curv     = math.abs(s_late - s_early) / atrWnz
        B = curv < epsCurv

        // C) stable & narrow bandwidth
        meanBw = ta.sma(bw, flat_W)
        sdBw   = ta.stdev(bw, flat_W)
        cvBw   = nz(sdBw) / (nz(meanBw) == 0.0 ? 1e-9 : nz(meanBw))
        bwRel  = nz(meanBw) / (nz(b) == 0.0 ? 1e-9 : nz(b))
        C = (cvBw < epsCv) and (bwRel < epsBwRel)

        adxVal = adxCustom(adxLen)
        D = useADX ? adxVal < adxMax : true

        A and B and C and D
    else
        false


// ---- New: BB(8) micro-trend alignment ----
bb8TrendAlign() =>
    b8 = ta.sma(close, BB_SHORT)
    s8 = _slope(b8, math.max(8, math.min(20, flat_W)), 0)
    longOK  = s8 > 0 and close > b8
    shortOK = s8 < 0 and close < b8
    [longOK, shortOK]

// Avoid late pullback: candle body relation to band
isNotLatePB(candleIndex, THE_BB, hitUp) =>
    hitUp ? (math.min(open[candleIndex], close[candleIndex]) <= THE_BB[candleIndex])
          : (math.max(open[candleIndex], close[candleIndex]) >= THE_BB[candleIndex])

// ======================= Candle anatomy & patterns =======================
body1 = math.abs(open[1] - close[1])
body2 = math.abs(open[2] - close[2])
body1Top = math.max(open[1], close[1])
body2Top = math.max(open[2], close[2])
body1Bottom = math.min(open[1], close[1])
body2Bottom = math.min(open[2], close[2])
upperShadow1 = high[1] - body1Top
lowerShadow1 = body1Bottom - low[1]

// TP/SL helper (kept)
calcTP_SL(hitUp) =>
    float TP = na
    float SL = na
    if hitUp
        SL := high[1] + (SL_To_Body_Ratio * body1)
        d = SL - close[1]
        TP := close[1] - d
    else
        SL := low[1] - (SL_To_Body_Ratio * body1)
        d = close[1] - SL
        TP := close[1] + d
    [TP, SL]

// 2CBB pattern (your original)
isCurrentBullish     = close[1] > open[1]
isHigherClose        = body1Top > body2Top
isUpperShadowSmall   = body1 > upperShadow1
is2CBB_Buy           = isCurrentBullish and isHigherClose

isCurrentBearish     = close[1] < open[1]
isLowerClose         = body1Bottom < body2Bottom
isLowerShadowSmall   = body1 > lowerShadow1
is2CBB_Sell          = isCurrentBearish and isLowerClose

// ======================= Hit tests vs BBs =======================
isHittingTheBBL1Down = calcIn3Candles ? (isHittingBB(1, BB_LONG1, false) or isHittingBB(2, BB_LONG1, false) or isHittingBB(3, BB_LONG1, false))
                                      : (isHittingBB(1, BB_LONG1, false) or isHittingBB(2, BB_LONG1, false))
isHittingTheBBL1Up   = calcIn3Candles ? (isHittingBB(1, BB_LONG1, true)  or isHittingBB(2, BB_LONG1, true)  or isHittingBB(3, BB_LONG1, true))
                                      : (isHittingBB(1, BB_LONG1, true)  or isHittingBB(2, BB_LONG1, true))

isHittingTheBBL2Down = calcIn3Candles ? (isHittingBB(1, BB_LONG2, false) or isHittingBB(2, BB_LONG2, false) or isHittingBB(3, BB_LONG2, false))
                                      : (isHittingBB(1, BB_LONG2, false) or isHittingBB(2, BB_LONG2, false))
isHittingTheBBL2Up   = calcIn3Candles ? (isHittingBB(1, BB_LONG2, true)  or isHittingBB(2, BB_LONG2, true)  or isHittingBB(3, BB_LONG2, true))
                                      : (isHittingBB(1, BB_LONG2, true)  or isHittingBB(2, BB_LONG2, true))

isHittingTheBBL3Down = calcIn3Candles ? (isHittingBB(1, BB_LONG3, false) or isHittingBB(2, BB_LONG3, false) or isHittingBB(3, BB_LONG3, false))
                                      : (isHittingBB(1, BB_LONG3, false) or isHittingBB(2, BB_LONG3, false))
isHittingTheBBL3Up   = calcIn3Candles ? (isHittingBB(1, BB_LONG3, true)  or isHittingBB(2, BB_LONG3, true)  or isHittingBB(3, BB_LONG3, true))
                                      : (isHittingBB(1, BB_LONG3, true)  or isHittingBB(2, BB_LONG3, true))

// Short BB directional helper from your code (kept, but BB8Trend replaces it in final condition)
isShortBBIncreasing = ShortBB_lower[1] > ShortBB_lower[2]
isShortBBDecreasing = ShortBB_upper[1] < ShortBB_upper[2]

// Close relation to BBs (kept as-is)
isCloseAboveBB1 = close[1] >= LongBB1_lower[1]
isCloseBelowBB1 = close[1] <= LongBB1_upper[1]
isCloseAboveBB2 = close[1] >= LongBB2_lower[1]
isCloseBelowBB2 = close[1] <= LongBB2_upper[1]
isCloseAboveBB3 = close[1] >= LongBB3_lower[1]
isCloseBelowBB3 = close[1] <= LongBB3_upper[1]

// ======================= Replace legacy range with New Flatness =======================
useFlatRange = input.bool(true, "Use New Flat-Range Logic (recommended)")
flat1 = isFlatBB(BB_LONG1)
flat2 = isFlatBB(BB_LONG2)
flat3 = isFlatBB(BB_LONG3)

// If someone disables new flatness, fall back to legacy "always true" unless calc flag shown.
isBBReallyInRange = useFlatRange ? (flat1 or flat2 or flat3) : true

// Tie flatness to the respective condition (per BB)
isConditionBuyBB1  = isHittingTheBBL1Down and isCloseAboveBB1 and (useFlatRange ? flat1 : true)
isConditionSellBB1 = isHittingTheBBL1Up   and isCloseBelowBB1  and (useFlatRange ? flat1 : true)
isConditionBuyBB2  = isHittingTheBBL2Down and isCloseAboveBB2 and (useFlatRange ? flat2 : true)
isConditionSellBB2 = isHittingTheBBL2Up   and isCloseBelowBB2  and (useFlatRange ? flat2 : true)
isConditionBuyBB3  = isHittingTheBBL3Down and isCloseAboveBB3 and (useFlatRange ? flat3 : true)
isConditionSellBB3 = isHittingTheBBL3Up   and isCloseBelowBB3  and (useFlatRange ? flat3 : true)

// RSI windows
isTheRSIValidForDown = calcIn3Candles ? (isRSIValid(1, false) or isRSIValid(2, false) or isRSIValid(3, false))
                                      : (isRSIValid(1, false) or isRSIValid(2, false))
isTheRSIValidForUp   = calcIn3Candles ? (isRSIValid(1, true)  or isRSIValid(2, true)  or isRSIValid(3, true))
                                      : (isRSIValid(1, true)  or isRSIValid(2, true))

// Group BB conditions
BBConditionsBuy  = disableBB100 ? (isConditionBuyBB2  or isConditionBuyBB3)  : (isConditionBuyBB1  or isConditionBuyBB2  or isConditionBuyBB3)
BBConditionsSell = disableBB100 ? (isConditionSellBB2 or isConditionSellBB3) : (isConditionSellBB1 or isConditionSellBB2 or isConditionSellBB3)

// New micro-trend filter via BB(8) slope + position
[bb8LongOK, bb8ShortOK] = bb8TrendAlign()

// Final conditions (replacing old short-BB increase/decrease check with bb8 alignment)
conditionBuy  = BBConditionsBuy  and isTheRSIValidForDown and is2CBB_Buy
conditionSell = BBConditionsSell and isTheRSIValidForUp  and is2CBB_Sell

// ======================= Styling / Plots =======================
labelPositionBuy  = low[1]  - (ta.atr(30) * 0.6)
labelPositionSell = high[1] + (ta.atr(30) * 0.6)

labelColorBuy     = input.color(color.blue, "Label Color Buy")
labelColorSell    = input.color(color.red, "Label Color Sell")
labelColorBuyBG   = input.color(color.new(color.blue, 90), "Label Color Buy Background")
labelColorSellBG  = input.color(color.new(color.red, 90), "Label Color Sell Background")

BB_Short_Color = input.color(color.blue,  "Short BB")
BB1_Color      = input.color(color.orange,"BB1 Color")
BB2_Color      = input.color(color.green, "BB2 Color")
BB3_Color      = input.color(color.red,   "BB3 Color")

BB1_LineWidth = input.int(1, "BB1 LineWidth")
BB2_LineWidth = input.int(2, "BB2 LineWidth")
BB3_LineWidth = input.int(3, "BB3 LineWidth")

bgcolor(conditionBuy  ? labelColorBuyBG  : na, 0)
bgcolor(conditionBuy  ? labelColorBuyBG  : na, -1)
bgcolor(conditionSell ? labelColorSellBG : na, 0)
bgcolor(conditionSell ? labelColorSellBG : na, -1)

plot(ShortBB_upper, color = BB_Short_Color)
plot(ShortBB_lower, color = BB_Short_Color)
plot(LongBB1_upper, color = BB1_Color, linewidth = BB1_LineWidth)
plot(LongBB1_lower, color = BB1_Color, linewidth = BB1_LineWidth)
plot(LongBB2_upper, color = BB2_Color, linewidth = BB2_LineWidth)
plot(LongBB2_lower, color = BB2_Color, linewidth = BB2_LineWidth)
plot(LongBB3_upper, color = BB3_Color, linewidth = BB3_LineWidth)
plot(LongBB3_lower, color = BB3_Color, linewidth = BB3_LineWidth)

labelTextBuy       = input.string("BB-PB Buy", "Label Text for Buy indicator")
labelTextSell      = input.string("BB-PB Sell", "Label Text for Sell indicator")
labelTooltipBuy    = input.string("BB-Pullback Buy", "Label Tooltip Text for Buy indicator")
labelTooltipSell   = input.string("BB-Pullback Sell", "Label Tooltip Text for Sell indicator")

// BB context string
context = isConditionBuyBB3 or isConditionSellBB3 ? str.tostring(BB_LONG3) : isConditionBuyBB2 or isConditionSellBB2 ? str.tostring(BB_LONG2) : isConditionBuyBB1 or isConditionSellBB1 ? str.tostring(BB_LONG1) : ""

// ======================= Alerts / Labels =======================
if conditionBuy
    label.new(bar_index - 1, labelPositionBuy, text = "Buy " + context, style = label.style_label_up, color = labelColorBuy, textcolor = color.white, tooltip = labelTooltipBuy + " " + context)
    alert("Buy BB-PullBack " + context, alert.freq_once_per_bar_close)
else if conditionSell
    label.new(bar_index - 1, labelPositionSell, text = "Sell " + context, style = label.style_label_down, color = labelColorSell, textcolor = color.white, tooltip = labelTooltipSell + " " + context)
    alert("Sell BB-PullBack " + context, alert.freq_once_per_bar_close)
